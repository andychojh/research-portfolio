# Data are excluded by default. Review each example before staging it.
papers/*/data/*
!papers/*/data/README.md
!papers/*/data/example/
!papers/*/data/example/**

# Only curated reference results belong in version control.
papers/*/results/*
!papers/*/results/README.md
!papers/*/results/reference/
!papers/*/results/reference/**
